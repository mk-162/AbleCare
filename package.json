{
  "name": "ablecare-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tinacms dev -c \"next dev --port 3001\"",
    "build": "tinacms build --skip-cloud-checks && next build",
    "start": "next start",
    "tina:schema": "tinacms build --local --skip-cloud-checks --skip-indexing --skip-search-index",
    "tina:lock": "npm run tina:schema && node scripts/check-tina-lock.mjs --write",
    "tina:lock:check": "npm run tina:schema && node scripts/check-tina-lock.mjs",
    "content:check": "node scripts/check-content-schema.mjs",
    "content:richtext": "node scripts/check-rich-text.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tinacms/cli": "^4.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.58.0",
    "markdown-it": "14.3.3",
    "minisearch": "^7.2.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.33.0",
    "tailwind-merge": "^3.7.0",
    "tinacms": "^3.14.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "katex": "^0.19.0",
    "postcss-selector-parser": "^7.1.6"
  }
}
